# Browser/public values only. Never put service-role keys in VITE_/NEXT_PUBLIC_ variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server-only secrets (Vercel Environment Variables)
SUPABASE_SERVICE_ROLE_KEY=SET_IN_VERCEL_ONLY
APP_BASE_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional one-time secret for a trusted operator to bind the first admin UUID through a protected setup procedure.
ADMIN_BOOTSTRAP_SECRET=
